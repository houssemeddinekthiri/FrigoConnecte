PORT=3001
DATABASE_URL=postgres://frigo:frigo@localhost:5432/frigoconnect
CORS_ORIGIN=http://localhost:3000

# Keycloak : KEYCLOAK_ISSUER = URL publique du realm (doit égaler le claim "iss" des jetons)
KEYCLOAK_ISSUER=http://localhost:8080/realms/frigoconnect
# URL interne (réseau Docker) pour l'API Admin ; JWKS_URL optionnel si l'URL publique n'est pas joignable depuis l'API
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=frigoconnect
KEYCLOAK_BACKEND_CLIENT_ID=frigoconnect-backend
KEYCLOAK_BACKEND_SECRET=change-me
# KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/frigoconnect/protocol/openid-connect/certs

# Temps réel : secret de signature des tickets WebSocket (>= 32 caractères aléatoires)
WS_TICKET_SECRET=change-me-with-at-least-32-random-characters
# Optionnel en dev ; requis dès 2 instances API (adaptateur Socket.IO)
# REDIS_URL=redis://localhost:6379

# MinIO (compatible S3). PUBLIC_ENDPOINT = hôte joignable par le NAVIGATEUR (embarqué dans les URLs pré-signées)
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=https://files.example.com
S3_BUCKET=frigoconnect
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Signature de devis : secret du HMAC des codes à usage unique (>= 32 caractères aléatoires)
OTP_SECRET=change-me-with-at-least-32-random-characters-too
# Emails (Resend). Sans clé en développement : le message est journalisé, pas envoyé.
# RESEND_API_KEY=re_xxx
# MAIL_FROM="FrigoConnect <no-reply@votre-domaine.fr>"

# Stripe (mode test d'abord : clés sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret de l'endpoint webhook (stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# URL publique du site (retour de l'onboarding Stripe Connect)
APP_URL=http://localhost:3000
# Commission par défaut en points de base (1000 = 10 %, calculée sur le HT)
DEFAULT_COMMISSION_BPS=1000
