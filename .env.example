# ============================================================================
# FrigoConnect : configuration de la pile Docker.   cp .env.example .env
# NE JAMAIS COMMITER .env. Générer chaque secret :   openssl rand -hex 32
# ============================================================================

# ---- Adresses publiques ------------------------------------------------------
# En production : https://votre-domaine.fr, https://auth.votre-domaine.fr, https://files.votre-domaine.fr
APP_URL=http://localhost:3000
APP_DOMAIN=localhost
KEYCLOAK_PUBLIC_URL=http://localhost:8080
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Adresse du serveur temps réel vue par le NAVIGATEUR (incorporée au site à la compilation : relancer « docker compose build web » si elle change)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ---- PostgreSQL (mots de passe en hexadécimal : pas de guillemet ni de caractère spécial) ----
POSTGRES_DB=frigoconnect
POSTGRES_USER=frigo
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# ---- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=

# ---- Keycloak ----------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Secret du compte de service de l'API (création d'utilisateurs, suspension)
KEYCLOAK_BACKEND_SECRET=

# ---- MinIO (stockage de fichiers) ---------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Compte applicatif limité au bucket. Le nom du bucket doit rester celui de infra/minio/policy.json
S3_BUCKET=frigoconnect
S3_ACCESS_KEY=frigoapp
S3_SECRET_KEY=

# ---- Secrets applicatifs (>= 32 caractères aléatoires) ----------------------------
AUTH_SECRET=
WS_TICKET_SECRET=
OTP_SECRET=

# ---- Stripe : MODE TEST d'abord (clés sk_test_ / pk_test_) ------------------------
# Webhook local :  stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe   (affiche whsec_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Commission par défaut en points de base (1000 = 10 %, calculée sur le HT)
DEFAULT_COMMISSION_BPS=1000

# ---- Emails (Resend). Sans clé en développement, les emails sont journalisés ----------
RESEND_API_KEY=
MAIL_FROM="FrigoConnect <no-reply@votre-domaine.fr>"

# ---- Images applicatives (NE PAS renseigner ici) --------------------------------------------
# En local, Compose construit les images (frigoconnect/api:local, frigoconnect/web:local).
# Sur un serveur, infra/scripts/deploy.sh fournit API_IMAGE et WEB_IMAGE (images GHCR) et les mémorise dans .images.env
# API_IMAGE=
# WEB_IMAGE=

# ---- Ports publiés sur 127.0.0.1 (changer SEULEMENT en cas de conflit avec un autre service local) ----
# WEB_PORT=3000
# API_PORT=3001
# KEYCLOAK_PORT=8080
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ---- Stockage S3 (images) : MinIO n'est plus publié sur les registres publics ; fork communautaire par défaut ----
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

# Test local : code de signature fixe (6 chiffres), affiché à l'écran au lieu d'être envoyé par email. Ignoré sauf avec une clé Stripe de test.
DEV_FIXED_CODE=
